<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.9</version>
        <relativePath/>
    </parent>

    <groupId>com.example</groupId>
    <artifactId>stock-manager-parent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>stock-manager-parent</name>
    <description>Multi-module backend for a Korean stock analysis service</description>

    <modules>
        <module>kiwoom-api-contract</module>
        <module>backdata-validation-engine</module>
        <module>stock-analysis-engine</module>
        <module>unified-analysis-engine</module>
        <module>trade-judgment-engine</module>
        <module>stock-manager-app</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <!-- MyBatis Starter 취약점 조치 버전 변경 (3.0.3 -> 3.0.4) -->
        <mybatis-spring-boot.version>3.0.4</mybatis-spring-boot.version>
    </properties>

</project>
